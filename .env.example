# Database
DATABASE_URL=postgresql+asyncpg://pip_user:pip_password@localhost:5433/portfolio_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Market Data
MARKET_DATA_PROVIDER=yahoo

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# App
APP_ENV=development
LOG_LEVEL=INFO
